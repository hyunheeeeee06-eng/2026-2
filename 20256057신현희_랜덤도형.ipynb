      "source": [
        "import random\n",
        "\n",
        "import ColabTurtle.Turtle as t\n",
        "\n",
        "t.initializeTurtle()\n",
        "\n",
        "for i in range(100):\n",
        "    length = random.randint(1, 100)\n",
        "    angle = random.randint(0, 360)\n",
        "\n",
        "    t.forward(length)\n",
        "    t.right(angle)\n",
        "\n",
        "turtle.done()"
